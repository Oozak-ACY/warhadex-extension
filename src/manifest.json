{
  "manifest_version": 3,
  "name": "Warhadex",
  "version": "1.0.1",
  "description": "Affiche les statistiques et les regles Warhammer 40000 du personnage sur les pages produit",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Warhadex",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://warhadex-api.orion-sphere.fr/*",
    "https://*.warhammer.com/*",
    "https://*.elementgames.co.uk/*",
    "https://*.waylandgames.co.uk/*",
    "https://*.philibertnet.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.warhammer.com/*",
        "https://*.elementgames.co.uk/*",
        "https://*.waylandgames.co.uk/*",
        "https://*.philibertnet.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/*",
        "core/*",
        "vendor/*",
        "assets/icons/*",
        "assets/logo/*",
        "assets/fonts/*"
      ],
      "matches": [
        "https://*.warhammer.com/*",
        "https://*.elementgames.co.uk/*",
        "https://*.waylandgames.co.uk/*",
        "https://*.philibertnet.com/*"
      ]
    }
  ]
}
